{
  "name": "setup-git-for-windows-sdk-root",
  "version": "1.11.0",
  "private": true,
  "workspaces": [
    "shared",
    "github-action",
    "azure-task"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "format": "npm run format --workspaces",
    "format-check": "npm run format-check --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "package": "npm run package --workspace=github-action && npm run package --workspace=azure-task",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm run test",
    "install-all": "npm install --workspaces"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/git-for-windows/setup-git-for-windows-sdk.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup",
    "git",
    "git-for-windows"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.34.0",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.34.0",
    "eslint-plugin-anti-trojan-source": "^1.1.1",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
